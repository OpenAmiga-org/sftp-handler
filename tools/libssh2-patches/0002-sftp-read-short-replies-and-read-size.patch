+/* libssh2_sftp_set_read_size
+ * The size of each FXP_READ request for files opened from now on.
+ */
+LIBSSH2_API size_t
+libssh2_sftp_set_read_size(LIBSSH2_SFTP *sftp, size_t size)
+{
+    if(!sftp)
+        return 0;
+    if(size < 1024)
+        size = 1024;
+    if(size > MAX_SFTP_READ_SIZE_LIMIT)
+        size = MAX_SFTP_READ_SIZE_LIMIT;
+    sftp->read_size = size;
+    return size;
