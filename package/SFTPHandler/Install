; Install script for sftp-handler (AmigaOS 4 Installation Utility).
; Public domain.

(set #app "SFTP Handler")
(set @app-name "SFTPHandler")
(set @default-dest "L:")

(set #bad 0)
(set #missing "")

(welcome
  (cat "This installs " #app ": the device SFTP: shows your FTP and SFTP "
       "sites as folders, and the prefs program sftphprefs keeps the list "
       "of sites."))

(if (= @user-level 0) (user 1))

; --- requirements -------------------------------------------------------

(procedure P_CHECK #lib #minver #minrev #what #where
  (set #v (getversion #lib (resident)))
  (if (= #v 0) (set #v (getversion (tackon "LIBS:" #lib))))
  (if (< #v (+ (* #minver 65536) #minrev))
    (
      (set #bad 1)
      (set #missing (cat #missing "\n\n" #what " (" #lib " " #minver "." #minrev
                         " or newer) is missing or too old.\nGet it from: " #where))
    )
  )
)

(P_CHECK "filesysbox.library" 54 8 "filesysbox"
         "AmigaOS 4.1 Final Edition updates")
(P_CHECK "clib4.library" 2 5 "clib4"
         "OS4Depot development/library/misc/clib4.lha\nor https://github.com/AmigaLabs/clib4/releases")
(P_CHECK "amisslmaster.library" 5 0 "AmiSSL (needed for SFTP)"
         "OS4Depot library/misc/amissl.lha\nor https://github.com/jens-maus/amissl/releases")

(if #bad
  (if (= 0 (askbool
        (prompt (cat "Some required libraries are missing:" #missing
                     "\n\nThe handler cannot work without them. You can install "
                     "it now and add the libraries later."))
        (help @askbool-help)
        (choices "Install anyway" "Stop")
        (default 0)))
    (exit (quiet))
  )
)

; --- programs -------------------------------------------------------------

; leftovers of an earlier install (see P_FREE), now no longer in use
(run "C:Delete >NIL: QUIET L:sftp-handler.old SYS:Prefs/sftphprefs.old")

; A running handler keeps L:sftp-handler in use: it cannot be replaced
; while SFTP: is mounted. Stop it first; it is mounted again at the end.
(set #wasmounted (= 0 (run "C:Assign >NIL: SFTP: EXISTS")))
(if #wasmounted
  (
    (message "SFTP: is mounted. To replace the handler, the installer "
             "stops it now and mounts it again at the end.\n\n"
             "Close any files you have open on SFTP: first.")
    (run "C:Dismount >NIL: SFTP:")
  )
)

; A file that is still in use (SFTP: could not be stopped, or sftphprefs is
; running) is moved aside, so that the new one can be copied in; the old
; one goes with the next restart.
(procedure P_FREE #file
  (if (exists #file)
    (if (<> 0 (run (cat "C:Delete >NIL: QUIET \"" #file "\"")))
      (
        (run (cat "C:Delete >NIL: QUIET \"" #file ".old\""))
        (run (cat "C:Rename >NIL: \"" #file "\" \"" #file ".old\""))
      )
    )
  )
)
(P_FREE "L:sftp-handler")
(copyfiles
  (prompt "Copying sftp-handler to L:")
  (help @copyfiles-help)
  (source "L/sftp-handler")
  (dest "L:")
  (confirm "expert"))

(P_FREE "SYS:Prefs/sftphprefs")
(copyfiles
  (prompt "Copying the prefs program sftphprefs to SYS:Prefs")
  (help @copyfiles-help)
  (source "Prefs/sftphprefs")
  (dest "SYS:Prefs")
  (infos)
  (confirm "expert"))

; --- the DOSDriver ------------------------------------------------------

(set #activate
  (askbool
    (prompt "Mount SFTP: every time the computer starts?\n"
            "(It connects to a site only when its folder is opened.)")
    (help @askbool-help)
    (default 1)))

(set #dddest (if #activate "DEVS:DOSDrivers" "SYS:Storage/DOSDrivers"))
(if (exists (tackon #dddest "SFTP"))
  (if (= 0 (askbool
        (prompt (cat (tackon #dddest "SFTP") " exists already. Replace it?"))
        (help @askbool-help)
        (default 1)))
    (set #dddest "")
  )
)
(if (<> #dddest "")
  (copyfiles
    (prompt (cat "Copying the DOSDriver to " #dddest))
    (help @copyfiles-help)
    (source "Devs/DOSDrivers/SFTP")
    (dest #dddest)
    (infos)
    (nogauge))
)

; --- volume icon ----------------------------------------------------------

; Workbench shows the SFTP: volume with ENV:Sys/def_SFTP.info, the same way
; as def_DF0 or def_RAD; the copy in ENVARC:Sys keeps it after a restart.
; (or) evaluates all its arguments, so the question needs an (if) of its own
(set #icon "Prefs/Env-Archive/Sys/def_SFTP.info")
(set #copyicon 1)
(if (exists "ENVARC:Sys/def_SFTP.info")
  (set #copyicon
    (askbool
      (prompt "ENVARC:Sys/def_SFTP.info (the icon of the SFTP: volume) "
              "exists already. Replace it?")
      (help @askbool-help)
      (default 1))))
(if #copyicon
  (
    (if (not (exists "ENVARC:Sys")) (makedir "ENVARC:Sys"))
    (if (not (exists "ENV:Sys")) (makedir "ENV:Sys"))
    (copyfiles
      (prompt "Copying the icon of the SFTP: volume to ENVARC:Sys")
      (help @copyfiles-help)
      (source #icon)
      (dest "ENVARC:Sys")
      (nogauge))
    (copyfiles
      (prompt "Copying the icon of the SFTP: volume to ENV:Sys")
      (help @copyfiles-help)
      (source #icon)
      (dest "ENV:Sys")
      (nogauge))
  )
)

; --- documentation ------------------------------------------------------

(set #docdir
  (askdir
    (prompt "Where should the documentation go?\n"
            "A drawer named SFTPHandler is created there.")
    (help @askdir-help)
    (default "SYS:Documentation")))

(set #docs (tackon #docdir "SFTPHandler"))
(makedir #docs (prompt "Creating the documentation drawer") (help @makedir-help) (infos))
(foreach "" "#?.(guide|txt)"
  (copyfiles
    (prompt "Copying the documentation")
    (help @copyfiles-help)
    (source @each-name)
    (dest #docs)
    (infos)
    (nogauge)))

; --- mount now ----------------------------------------------------------

; the DOSDriver to mount: the one just copied, or the one that was there
(set #ddfile "")
(if (<> #dddest "")
  (set #ddfile (tackon #dddest "SFTP"))
  (if (exists "DEVS:DOSDrivers/SFTP")
    (set #ddfile "DEVS:DOSDrivers/SFTP")
    (if (exists "SYS:Storage/DOSDrivers/SFTP")
      (set #ddfile "SYS:Storage/DOSDrivers/SFTP"))))

(if (= 0 (run "C:Assign >NIL: SFTP: EXISTS"))
  ; still mounted: Dismount did not work (files open on SFTP:)
  (message "SFTP: could not be stopped, so the old handler keeps running. "
           "The new one is used after the computer restarts.")
  (if (and (<> #ddfile "") (or #wasmounted (<> #dddest "")))
    (run (cat "C:Mount " #ddfile)))
)
(if (askbool
      (prompt "Start sftphprefs now to add your sites?")
      (help @askbool-help)
      (default 1))
  (run "Run >NIL: SYS:Prefs/sftphprefs")
)

(exit (cat #app " is installed.\n\nAdd your sites with SYS:Prefs/sftphprefs; "
           "they appear as folders in SFTP:.\nRead " (tackon #docs "SFTPHandler.guide")
           " for the details.") (quiet))
